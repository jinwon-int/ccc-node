# CI verification tools installed with hash checking.
# Runtime/dev bridge dependencies come from bridge/pyproject.toml via pip-compile.
# Regenerate both this lock and bridge/requirements.lock.txt together with
# scripts/ccc-deps-lock.sh so one PR carries one verified resolution.
ruff
mypy
build
pip-audit
# Per-test wall-clock cap for the bridge suite (bridge/pyproject.toml sets
# [tool.pytest.ini_options] timeout). CI-only: a hung test fails fast with a
# stack dump instead of stalling the runner until the job-level timeout.
pytest-timeout
# Pinned build backend so the wheel-smoke job builds with --no-isolation and
# never fetches an unhashed setuptools at build time (bridge/pyproject.toml
# requires setuptools>=68).
setuptools>=68
# Termux native build backend cap (bridge/termux_prepare.py MATURIN_VERSION).
# Termux nodes compile these sdists with the reviewed system maturin 1.14.1;
# jiter>=0.17 and pydantic-core>=2.50 (pulled by pydantic>=2.14) declare
# maturin>=1.15 and fail `native-wheels` with --check-build-dependencies.
# Lift these caps only together with a reviewed MATURIN_VERSION bump.
jiter<0.17
pydantic<2.14
