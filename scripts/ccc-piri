#!/usr/bin/env bash
# ccc-piri — materialize the ccc-node snapshot into the Piri global context
# file before every Piri run. Node-global counterpart of ccc-codex: the
# materializer writes <CODEX_HOME>/AGENTS.md, so CODEX_HOME is pointed at the
# Piri agent dir, whose AGENTS.md Piri auto-loads as its global context file.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
materializer="${CCC_PIRI_MEMORY_MATERIALIZER_PATH:-$SCRIPT_DIR/ccc_codex_memory.py}"
real_candidate="${CCC_PIRI_REAL_CLI_PATH:-piri}"
memory_home="${CCC_PIRI_MEMORY_HOME:-$HOME/.piri/agent}"

skip=0
# Isolated tool-free extractor runs (nunchi piri-feed) must not receive user
# memory; route them straight to the real CLI.
case "${PIRI_CODING_AGENT_SESSION_DIR:-}" in
  */.piri-feed-extractor-sessions|*/.piri-feed-extractor-sessions/*) skip=1 ;;
esac
# Audience-scoped sessions are bootstrapped by the bridge runtime itself
# (--no-context-files --append-system-prompt); never touch global memory here.
case "${CCC_MEMORY_AUDIENCE_SCOPED:-0}" in
  1|true|TRUE|on|ON|yes|YES) skip=1 ;;
esac
[ "${CCC_PIRI_MEMORY_SKIP:-0}" = "1" ] && skip=1

if [ "$skip" != "1" ]; then
  if [ ! -f "$materializer" ] || [ ! -x "$materializer" ] || [ -L "$materializer" ]; then
    printf "%s\n" "ccc-piri: memory bootstrap unavailable" >&2
    exit 78
  fi
  # Same shebang fallback as ccc-codex: Android has no /usr/bin/env, so
  # without libtermux-exec's LD_PRELOAD hook the kernel cannot exec the
  # `#!/usr/bin/env python3` materializer and the bootstrap would exit 78.
  # Retry through an explicit interpreter from PATH (python3 ignores shebangs).
  # materialize carries the full env prefix — Piri nodes inject the nunchi-primary
  # snapshot through this path only, and the canonical loader output alone exceeds
  # the 8192 default, so CCC_CODEX_MEMORY_MAX_BYTES defaults to 16KiB (hard max
  # 24576); an explicit value always wins. status only needs CODEX_HOME,
  # preserving the original asymmetry.
  run_materializer() {
    local sub="$1"
    local -a pre
    if [ "$sub" = "materialize" ]; then
      pre=(env CODEX_HOME="$memory_home" CCC_MEMORY_MATERIALIZER_PROVIDER="${CCC_MEMORY_MATERIALIZER_PROVIDER:-piri}" CCC_CODEX_MEMORY_MAX_BYTES="${CCC_CODEX_MEMORY_MAX_BYTES:-16384}")
    else
      pre=(env CODEX_HOME="$memory_home")
    fi
    if "${pre[@]}" "$materializer" "$sub" --json >/dev/null 2>&1; then
      return 0
    fi
    local interpreter
    interpreter="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
    [ -n "$interpreter" ] || return 1
    "${pre[@]}" "$interpreter" "$materializer" "$sub" --json >/dev/null 2>&1
  }
  if ! run_materializer materialize; then
    # A refresh failure may proceed only when a previously materialized block
    # is still structurally valid and private. status is read-only/body-free.
    if ! run_materializer status; then
      printf "%s\n" "ccc-piri: memory bootstrap unavailable" >&2
      exit 78
    fi
  fi
fi

case "$real_candidate" in
  ""|-*)
    printf "%s\n" "ccc-piri: real CLI unavailable" >&2
    exit 127
    ;;
  */*) real_cli="$real_candidate" ;;
  *) real_cli="$(command -v "$real_candidate" 2>/dev/null || true)" ;;
esac

if [ -z "${real_cli:-}" ] || [ ! -x "$real_cli" ] || [ ! -f "$real_cli" ]; then
  printf "%s\n" "ccc-piri: real CLI unavailable" >&2
  exit 127
fi
if [ "$real_cli" -ef "$0" ]; then
  printf "%s\n" "ccc-piri: recursive real CLI configuration" >&2
  exit 127
fi

# #1184: the final exec must be shebang-aware for the same reason the
# materializer exec is (#1183). Android has no /usr/bin/env, so without
# libtermux-exec's LD_PRELOAD hook (dropped deliberately by the bridge's
# isolated distill env) the kernel cannot exec a `#!/usr/bin/env X` real
# CLI — and a failed execve cannot be caught in-process (a non-interactive
# shell exits on exec failure), so the routing decision happens up front:
# env-shebang scripts exec through the interpreter resolved from PATH;
# ELF binaries and absolute-shebang scripts exec directly — the kernel
# handles both without the hook. An unresolvable interpreter keeps the old
# behavior (direct exec), so hooked environments are unaffected. argv[0]
# becomes the resolved interpreter; `env -S` fixed args are honored. The
# piri chain's later hops (pi-test.sh -> tsx, an `#!/usr/bin/env node`
# script) belong to the piri repo and still need their own resolution for
# fully stripped-env use — this boundary covers the first hop only.
case "$(head -c 15 "$real_cli" 2>/dev/null)" in
  '#!/usr/bin/env ')
    env_shebang="$(head -n 1 "$real_cli")"
    env_shebang="${env_shebang#'#!/usr/bin/env '}"
    case "$env_shebang" in -S\ *) env_shebang="${env_shebang#-S }" ;; esac
    shebang_interp="${env_shebang%% *}"
    case "$shebang_interp" in
      ''|*/*) ;;  # empty or unexpected path form: fall through to direct exec
      *)
        shebang_resolved="$(command -v "$shebang_interp" 2>/dev/null || true)"
        if [ -n "$shebang_resolved" ]; then
          shebang_args="${env_shebang#"$shebang_interp"}"
          shebang_args="${shebang_args# }"
          # shellcheck disable=SC2086 # fixed args from the shebang line, intentional splitting
          exec "$shebang_resolved" $shebang_args "$real_cli" "$@"
        fi
        ;;
    esac
    ;;
esac

exec "$real_cli" "$@"  # ccc:interpreter-ok: #1184 — env-shebang scripts are routed through a PATH-resolved interpreter above; only ELF / absolute-shebang / hooked-env targets reach this direct exec
