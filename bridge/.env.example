# Telegram Skill Bot Environment Configuration

# Required: Get your bot token from @BotFather (https://t.me/BotFather)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN = your_bot_token_here

# Access control: comma-separated list of allowed Telegram user IDs.
# To get your user ID, send /start to @userinfobot
# ALLOWED_USER_IDS=123456789,987654321
#
# Fail-closed (default): if ALLOWED_USER_IDS is empty the bridge REFUSES to
# start, so it is never accidentally open to every Telegram user. To run an
# intentionally open bridge, leave ALLOWED_USER_IDS empty AND set:
# CCC_REQUIRE_ALLOWLIST=false

# Owner-only /restart handoff (Linux systemd only). Default off. The command is
# accepted only in a private chat with exactly one ALLOWED_USER_IDS owner.
# A delayed transient unit outside the bridge cgroup performs the restart.
# CCC_BRIDGE_RESTART_HANDOFF=systemd
# CCC_BRIDGE_RESTART_UNIT=ccc-telegram-bridge.service
# CCC_BRIDGE_RESTART_DELAY_SECONDS=5

# Logging and timeout
# LOG_LEVEL=INFO
# CLAUDE_PROCESS_TIMEOUT=21600
# CCC_DELEGATED_TASK_STALL_SECONDS=7200
# CLAUDE_AUTH_STATUS_TIMEOUT=15

# Maximum bytes for one Claude Agent SDK stdout NDJSON line (default 16777216
# = 16 MiB; accepted range 1 MiB - 256 MiB). The bridge always sets this
# explicitly because the SDK's own fallback is 1 MiB, and a single line over
# the limit raises SDKJSONDecodeError inside the SDK message reader, killing
# the whole turn with "JSON message exceeded maximum buffer size of 1048576
# bytes". Measured 2026-08-03: a 510 KB PNG read by the Read tool was resized
# to 682x2000 (528,000 base64 chars) and shipped twice in one message
# (message.content[].source.data AND toolUseResult.file.base64), producing a
# 1,056,854-byte line — i.e. ONE image over ~524 KB of base64 was enough.
# Raise this only if image-heavy turns still overflow; it bounds a buffer and
# does not preallocate memory.
# CCC_CLAUDE_MAX_BUFFER_SIZE=16777216

# Terminal-event stall release (issue #411 C). When the agent produced answer
# text but its completion signal never arrives, the request would otherwise
# hold the conversation until CLAUDE_PROCESS_TIMEOUT. After this many seconds
# of total stream silence following the last assistant text — with no tool
# running and no approval pending — the buffered answer is delivered once with
# a stall notice, the turn is interrupted, and queued messages proceed.
# Applies to both the Claude SDK and provider-neutral (Codex) paths.
# Set 0 to disable. Default: 300.
# CCC_TERMINAL_STALL_SECONDS=300

# Approval-stall release (issue #784 proposal 3). An admitted turn whose
# provider approval remains pending is failed on this separate wall-clock
# deadline. Running tools are not subject to this guard. The abandoned session
# and approval buttons are cleaned before queued messages proceed.
# Set 0 to disable. Default: 120.
# CCC_APPROVAL_STALL_SECONDS=120

# Agent provider (default: claude). Supported values: claude, codex.
# CCC_AGENT_PROVIDER=claude
#
# Durable, body-free usage metering by KST day, provider, and mode. Metering
# writes interactive/autonomous counters to .telegram_bot/usage-meter.json.
# A token budget of 0 disables that provider's daily autonomous allowance.
# Interactive spend remains metered but does not consume the allowance and is
# never rejected. Enforcement blocks autonomous spend only; the warning
# threshold is a percentage from 1 to 99.
# CCC_USAGE_METER_ENABLED=true
# CCC_USAGE_BUDGET_TOKENS_CLAUDE=0
# CCC_USAGE_BUDGET_TOKENS_CODEX=0
# CCC_USAGE_BUDGET_WARN_PERCENT=80
#
# Persisted Claude sessions resume after a bridge restart by default when their
# SDK transcript still exists. Set false only for a never-resume policy.
# CCC_RESUME_PERSISTED_SESSIONS=true
#
# Claude-provider-only dead-session wakeup (default OFF). When a background task
# finishes after its owning session has died/exited, this resumes the session for
# a bounded turn so pending notifications reach the user instead of remaining
# orphaned in the transcript until the user happens to send a manual message.
# Requires CCC_RESUME_PERSISTED_SESSIONS (default true).
# CAUTION: enabling this causes AUTONOMOUS TURNS THAT CONSUME TOKENS. Spend is
# metered as "autonomous" in usage-meter.json and gated by the provider's daily
# autonomous token allowance.
# CCC_DEAD_SESSION_WAKEUP=false
#
# Memory-source isolation for external/independent nodes. These values are
# validated by the bridge and inherited by bridge-owned Claude hooks. The
# external profile forces Wiki off even if a lower-priority value says 1.
# CCC_NODE_ISOLATION_PROFILE=fleet
# CCC_WIKI_MEMORY_ENABLED=1
# CCC_MEMORY_USER_LABEL=Seo Jin On
# CCC_MEMORY_ASSISTANT_LABEL=ccc-node assistant
# Codex only: setup.sh installs a memory-bootstrap launcher and materializer under
# ~/.claude/hooks. The package defaults point there; set explicit absolute paths
# only for a custom harness location. The wrapper invokes the real binary from
# CCC_CODEX_REAL_CLI_PATH (default: codex).
# CCC_CODEX_CLI_PATH=/home/user/.claude/hooks/ccc-codex
# CCC_CRUSH_CLI_PATH=crush  # crush executable for the crush provider (#926)
# Default workspace model for crush turns without an explicit /model choice,
# in provider/model form. Without it crush silently falls back to its bundled
# provider default, which can route turns to an unintended backend (#926).
# CCC_CRUSH_MODEL=kimi/k3
# CCC_CODEX_MEMORY_MATERIALIZER_PATH=/home/user/.claude/hooks/ccc_codex_memory.py
# CCC_CODEX_MEMORY_BOOTSTRAP_TIMEOUT_SEC=14
# CCC_CODEX_REAL_CLI_PATH=codex
# The audience-local distill worker uses ccc-memory-index.sh installed beside
# CCC_CODEX_MEMORY_MATERIALIZER_PATH for immediate no-network write→read parity.
# Audience-scoped Codex requires credentials pre-provisioned in the operating
# system keyring. File auth.json credentials are never copied between homes.
# CCC_CODEX_AUDIENCE_AUTH_MODE=keyring
# Optional Codex distill checkpoints. All gates default to 0 (disabled).
# When multiple gates are enabled, the first completed-turn count, UTF-8 byte
# count, or runtime age boundary reached records a durable journal job. The
# interactive turn never waits for provider extraction.
# CCC_CODEX_DISTILL_CHECKPOINT_TURNS=0
# CCC_CODEX_DISTILL_CHECKPOINT_BYTES=0
# CCC_CODEX_DISTILL_CHECKPOINT_AGE_SECONDS=0
# Isolated provider-call policy. provider-default preserves the Codex CLI's
# built-in default; a safe explicit model ID is passed with --model. Timeout is
# bounded to 1..600 seconds. Cost warn/enforce uses the shared CCC_USAGE_* gate.
# CCC_CODEX_DISTILL_MODEL=provider-default
# CCC_CODEX_DISTILL_TIMEOUT_SEC=120

# Telegram delivery rendering. These controls are independent from live draft
# streaming unless noted; values shown are the package defaults.
# CCC_TELEGRAM_READABLE_RENDERER=true
# CCC_TELEGRAM_ENTITY_RENDERER=true
# CCC_TELEGRAM_PART_HEADERS=true
# CCC_TELEGRAM_LOOSE_SPACING=true
# CCC_TELEGRAM_SPACING_LINES=2
# CCC_TELEGRAM_MAX_BUBBLE_CHARS=1200
# CCC_TELEGRAM_OPTION_BUTTONS=false
#
# Live draft streaming is off by default. CCC_PARTIAL_STREAMING selects
# token-level rather than whole-block updates only when the master switch is on.
# CCC_TELEGRAM_STREAMING=false
# CCC_PARTIAL_STREAMING=true
#
# Streaming update cadence
DRAFT_UPDATE_MIN_CHARS = 30
DRAFT_UPDATE_INTERVAL = 1.0

# Show Claude tool calls in Telegram streaming messages (default: disabled)
# ENABLE_STREAMING_TOOL_CALLS=false

# Optional: absolute path to Claude CLI (auto-detected by default)
# CLAUDE_CLI_PATH=/absolute/path/to/claude

# Optional: path to Claude Code settings.json (defaults to ~/.claude/settings.json)
# CLAUDE_SETTINGS_PATH=/absolute/path/to/settings.json

# Execution boundary (independent from Bash approval UX):
# - strict-project (package default): fail-closed project-root OS sandbox
# - owner-operator: no OS sandbox; normal host-capable Claude Code execution.
#   Requires CCC_REQUIRE_ALLOWLIST=true and exactly one ALLOWED_USER_IDS owner.
# - disabled: hard-deny Bash. Unknown/unsafe values also fail closed to disabled.
# CCC_BRIDGE_EXECUTION_PROFILE=strict-project
#
# Bash approval inside the selected execution profile (default: auto-approve):
# CCC_BRIDGE_BASH_POLICY=auto-approve  # Codex never + unrestricted host/network access
# CCC_BRIDGE_BASH_POLICY=auto-review   # Codex on-request + reviewer + workspace sandbox
# CCC_BRIDGE_BASH_POLICY=approve-each  # explicit one-time Telegram approval
# CCC_BRIDGE_BASH_POLICY=disabled      # remove Bash entirely
#
# Opt-in Codex parity for the Claude path (default false; owner-operator only,
# ignored elsewhere). True drops the host settings chain (no host
# hooks/settings), bypasses permissions, and removes the OS sandbox — matching
# Codex's never + dangerFullAccess. Memory context is preserved. Reversible per node.
# Ignored under root (Claude Code refuses bypassPermissions with root/sudo);
# run the bridge non-root to use it.
# CCC_BRIDGE_CLAUDE_UNRESTRICTED=false
#
# In Codex auto-approve mode, every turn carries dangerFullAccess regardless of
# execution profile. There is no sandbox or approval prompt: when the bridge runs
# as root, every allowlisted Telegram user can drive host, network, systemd, SSH,
# Tailscale, and out-of-workspace operations. Prefer a single trusted owner.
# In Codex auto-review mode, routine workspace work proceeds automatically. The
# reviewer agent evaluates eligible boundary crossings; network remains disabled
# inside the workspace sandbox unless an escalation is separately approved.
# Linux/WSL2 strict-project prerequisite: bubblewrap + socat. owner-operator
# deliberately restores host utility and therefore trusts the sole owner access
# boundary; it is not a defense against prompt injection in owner-visible input.
# Codex approvals routed to Telegram are owner-only, one request at a time. There
# is no "Allow All" option: each surfaced request must be explicitly allowed or
# denied for the current turn. Claude and Codex prompts show only a bounded,
# redacted target snapshot. Request/display fingerprints bind the one-shot token;
# body-free asked/decision records live under BOT_DATA_DIR/approval-audit.
# Never run two bridge services that poll the same TELEGRAM_BOT_TOKEN concurrently.

# Telegram conversation scope (default: per-user-chat).
# shared-groups keeps DMs user-isolated but lets all allowlisted senders in the
# same group share that group's session, queue, lock, and provider stream.
# Session control commands in that group therefore affect every allowed sender.
# Different groups never share state.
# CCC_TELEGRAM_SESSION_SCOPE=shared-groups
# shared-all is broader: every allowed sender's DM and every group share one
# session, queue, lock, provider stream, and session-control command state.
# CCC_TELEGRAM_SESSION_SCOPE=shared-all

# Curated memory lifecycle for non-owner profiles (default: off). This keeps
# setting_sources=[] and loads only ccc-node memory/distill hooks through a
# flag-settings layer; it does not enable project/user settings or Bash.
# CCC_BRIDGE_MEMORY_MODE=curated
# For multi-surface bots, audience-scoped is the safe sharing mode: every
# group/channel reads and writes the public shared store; a DM reads that store
# plus an opaque per-user private store. Unscoped legacy memory is DM-private,
# and global Honcho/Family Wiki paths are disabled until they have physical
# per-audience sessions/labels. Use with shared-groups, never shared-all.
# CCC_BRIDGE_MEMORY_MODE=audience-scoped
# Optional owner-only storage overrides (the generated key must remain 0600):
# CCC_BRIDGE_MEMORY_AUDIENCE_ROOT=/var/lib/ccc-node/memory-audiences
# CCC_BRIDGE_MEMORY_AUDIENCE_KEY_PATH=/var/lib/ccc-node/memory-audience.key
# Legacy curated + shared-all now fails closed. This compatibility escape hatch
# deliberately restores the old unsafe behavior and does not apply to
# audience-scoped mode:
# CCC_BRIDGE_UNSAFE_SHARED_ALL_MEMORY=false

# Curated web routing for profiles that suppress user/project/local settings.
# Default is off. This opt-in injects exactly two MCP capabilities into the
# Claude bridge: SearXNG for search and Firecrawl scrape for known-URL fetch.
# Built-in WebSearch/WebFetch, Firecrawl search, and SearXNG URL fetch are
# denied while this mode is active. Keep this file owner-only when it contains
# the Firecrawl key.
# CCC_BRIDGE_WEB_MCP_MODE=searxng-firecrawl
# CCC_BRIDGE_SEARXNG_URL=https://searxng.example.com
# CCC_BRIDGE_FIRECRAWL_API_KEY=fc-your-key

# Bound image-heavy context (default: off). When enabled, unchanged images may
# be Read once per request and inbound Telegram images are capped before model
# submission. Telegram photo variants above the pixel cap are skipped.
# CCC_BRIDGE_IMAGE_CONTEXT_GUARD=true
# CCC_TELEGRAM_MAX_IMAGE_BYTES=5242880
# CCC_TELEGRAM_MAX_IMAGE_PIXELS=4000000

# Optional: automatically start a new Claude session when the gap since the
# previous user message exceeds this many hours.
# Default is 24 hours.
# Set to 0, false, or off to disable this behavior and keep the previous
# "do not auto-start a new session" behavior.
# AUTO_NEW_SESSION_AFTER_HOURS=24

# Default-on resident session resource guard. It only closes idle provider
# runtimes; sessions.json remains unchanged and the next message resumes the
# durable provider thread. Active requests are never evicted or recycled.
# CCC_BRIDGE_SESSION_GUARD_ENABLED=true
# CCC_BRIDGE_SESSION_GUARD_INTERVAL_SECONDS=60
# CCC_BRIDGE_SESSION_IDLE_TTL_SECONDS=14400
# CCC_BRIDGE_MAX_RESIDENT_SESSIONS=2
# CCC_BRIDGE_SESSION_TREE_RSS_LIMIT_MB=1024
# CCC_BRIDGE_CODEX_MAX_ATTACHMENTS=2
#
# Elapsed-time follow-up acknowledgement while a turn is already active.
# Durable queue acceptance/rejection receipts remain visible when this is off.
# CCC_BRIDGE_BUSY_NOTICE_ENABLED=true
# CCC_BRIDGE_BUSY_NOTICE_MIN_ELAPSED_SECONDS=10
#
# Follow-ups received during an active turn are saved in an owner-only,
# restart-safe FIFO. The cap applies per conversation; overflow is rejected
# with an explicit Telegram reply instead of dropping the message silently.
# CCC_BRIDGE_FOLLOWUP_QUEUE_CAP=32
# Retained discard receipts have a separate cap. Reaching it pauses that
# conversation with the newest failed item still queued; older receipts stay.
# CCC_BRIDGE_FOLLOWUP_FAILURE_NOTIFICATION_CAP=32
# Dispatch and discard-notification retries use these increasing wall-clock
# delays. Unexpected worker crashes restart with exponential backoff and stop
# permanently for that conversation after the configured consecutive cap.
# CCC_BRIDGE_FOLLOWUP_RETRY_BACKOFF_SECONDS=1,5,30
# CCC_BRIDGE_FOLLOWUP_WORKER_RESTART_CAP=3
# CCC_BRIDGE_FOLLOWUP_WORKER_RESTART_BACKOFF_SECONDS=1

# Optional: OpenAI API key for voice message transcription (Whisper)
# OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible Whisper endpoint (for non-official providers)
# OPENAI_BASE_URL=https://your-whisper-endpoint/v1

# Optional: voice transcription channel
# Supported values: whisper (default), volcengine
# TRANSCRIPTION_PROVIDER=whisper
#
# Optional: Volcengine bigmodel file ASR settings
# Required when TRANSCRIPTION_PROVIDER=volcengine
# VOLCENGINE_APP_ID=your_app_id
# VOLCENGINE_TOKEN=your_token
# VOLCENGINE_ACCESS_KEY=AKLTxxxxxxxx
# VOLCENGINE_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
# VOLCENGINE_TOS_BUCKET_NAME=your_bucket_name
# VOLCENGINE_TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
# VOLCENGINE_TOS_REGION=cn-shanghai
# Create Secret Access Key in IAM key management:
# https://console.volcengine.com/iam/keymanage

# Optional: Whisper model for transcription
# WHISPER_MODEL=whisper-1

# Optional: Maximum accepted voice message duration in seconds
# MAX_VOICE_DURATION=300

# Optional: Maximum inbound Telegram document size in decimal MB (1-20)
# CCC_MAX_DOCUMENT_SIZE_MB=10

# Optional: custom ffmpeg binary path (defaults to ffmpeg in PATH)
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional: macOS voice reply mode settings
# VOICE_REPLY_PERSONA=Tingting
# Common built-in macOS voices: Tingting, Mei-Jia, Sin-ji, Samantha, Alex, Daniel, Karen, Moira
# Chinese suggestion (if available on your system): Yue (Premium)
# Use `say -v ?` to list voices available on your machine.

# Network proxy (optional): start.sh will auto-configure http_proxy/https_proxy/all_proxy
# PROXY_URL=http://127.0.0.1:7890

# Dependency install mode (issue #349). By default start.sh installs the
# hash-locked bridge/requirements.lock.txt with pip --require-hashes, so every
# node at the same checkout resolves identical dependency versions and any
# unhashed transitive dependency is rejected. Set 1 ONLY when this host cannot
# install a locked artifact (report the platform gap): it falls back to the
# legacy lower-bound requirements.txt flow and loses reproducibility.
# Locks are regenerated together via scripts/ccc-deps-lock.sh.
# CCC_DEPS_UNLOCKED=0

# ── Runtime health probe + threshold alerts (issue #389, detection-only) ────────────
# Every interval the bridge exports four structured signals to health.json
# (signals section): session liveness (dead reader streams), heartbeat age vs
# request lifetime, pending/dropped notifications, and orphan node-claude
# children. Threshold crossings are logged and queued as owner-only alerts
# through the push-notifier spool — a real Telegram send additionally requires
# CCC_PUSH_ENABLED, so with push disabled alerts stay in logs + health.json.
# Threshold rationale: heartbeat-age factor 1.0 fires the moment a request
# outlives CLAUDE_PROCESS_TIMEOUT (#307 class); one dead stream is already a
# delivery outage; a 10-file spool backlog means delivery is stuck, not busy;
# the reaper keeps orphans at zero, so any survivor means the reaper is broken.
# CCC_HEALTH_ALERTS_ENABLED=true
# CCC_HEALTH_ALERTS_INTERVAL_SECONDS=60
# CCC_HEALTH_ALERTS_COOLDOWN_SECONDS=1800
# CCC_ALERT_HEARTBEAT_AGE_FACTOR=1.0
# CCC_ALERT_MAX_DEAD_STREAMS=1
# CCC_ALERT_MAX_PENDING_NOTIFICATIONS=10
# CCC_ALERT_MAX_ORPHAN_CHILDREN=1

# ── ccc-node push notifier (owner-only outbound Claude Code notifications) ──────────
# DISABLED by default. Opt-in: the bridge delivers short, body-free lifecycle summaries
# that the Claude Code notify hook (CCC_NOTIFY_TELEGRAM=1) drops into the spool. The bot
# token never leaves the bridge. Owner-only: target is CCC_PUSH_CHAT_ID, or the sole
# ALLOWED_USER_IDS entry when unambiguous.
# CCC_PUSH_ENABLED=false
# CCC_PUSH_CHAT_ID=                  # owner Telegram chat id (numeric); empty = sole ALLOWED_USER_IDS
# CCC_PUSH_SPOOL=~/.claude/state/telegram-spool
# CCC_PUSH_POLL_INTERVAL=3.0
# CCC_PUSH_MAX_PER_MINUTE=10
#
# Fail-closed allowlist for agent-cron notify=telegram-chat* targets. Accepts a
# comma/space-separated list or JSON list of numeric group ids/@channel names;
# empty/unset (the default) disables record-targeted group/channel delivery.
# CCC_AGENT_CRON_NOTIFY_ALLOWED_CHATS=-1001234567890,@example-channel

# ── provider-neutral lifecycle audit (#645) ──────────────────────────────────
# DISABLED by default. When enabled, live AgentEvents and the installed Claude
# Bash hooks converge on the same body-free, owner-only bounded ledger under
# BOT_DATA_DIR. Hook feed failures are fail-open and never block a turn.
# CCC_LIFECYCLE_AUDIT=false
# CCC_LIFECYCLE_AUDIT_NOTIFY=false  # optional evidence-missing owner spool
