# ccc-node Matrix frontend (family messenger) — systemd unit example (#1780).
#
# Runs the SAME ProjectChatHandler as the Telegram bridge behind the E2EE
# Matrix transport, as a second service on the same node/project root.
# Install: copy to /etc/systemd/system/ccc-matrix-bridge.service, adjust the
# paths, `systemctl daemon-reload && systemctl enable --now ccc-matrix-bridge`.
#
# Prerequisites on the node:
#   - bridge venv with the matrix extra: <venv>/bin/pip install -r bridge/requirements-matrix.txt
#   - private 0600 config JSON (see docs/matrix-frontend.md); reuse the pilot
#     bot's config + state_directory so no new Matrix device is created
#   - the pilot service (family-matrix) stopped — one bot device runs once
#
# Provider / auth env (#1771). This unit runs `python -m telegram_bot` directly,
# NOT bridge/start.sh, so start.sh's bridge/.env export never happens here. Only
# the wrapper paths (WRAPPER_ENV_KEYS, #2065) are handed from the .env files to
# the wrapper child; keys that must be in the PROCESS env for both frontends —
# provider selection and every secret — belong in the shared owner-only
# EnvironmentFile below, which the Telegram unit (bridge/service-systemd.sh)
# reads too:
#   install -d -m 0700 /root/.config/ccc-node
#   install -m 0600 /dev/null /root/.config/ccc-node/bridge.env   # then edit
#   # e.g. CCC_AGENT_PROVIDER=piri, CCC_PIRI_CLI_PATH=..., CCC_PIRI_REAL_CLI_PATH=...,
#   #      CLAUDE_CODE_OAUTH_TOKEN=... (secrets ONLY here, never in Environment=)
#   systemd-analyze verify /etc/systemd/system/ccc-matrix-bridge.service
# EnvironmentFile= overrides Environment= lines, so never put HOME, PATH,
# PROJECT_ROOT, BOT_DATA_DIR, CCC_CHANNEL or CCC_MATRIX_* in the shared file.
# This replaces the older hand-mirrored provider.conf drop-in (jingun/nosuk
# 2026-09-18: a missing drop-in, or one without its [Service] header, silently
# ran the default provider / lost the real CLI path). See docs/bridge-ops.md.
[Unit]
Description=ccc-node Matrix frontend (family messenger, CCC_CHANNEL=matrix)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ccc-node/bridge
Environment=HOME=/root
Environment=PROJECT_ROOT=/root
# Separate runtime data so pid/health/session files never collide with the Telegram bridge.
Environment=BOT_DATA_DIR=/root/.ccc-matrix
Environment=CCC_CHANNEL=matrix
Environment=CCC_MATRIX_CONFIG_PATH=/etc/family-matrix/config.json
# Shared with the Telegram unit; optional ("-") until the node's file is placed.
EnvironmentFile=-/root/.config/ccc-node/bridge.env
ExecStart=/opt/ccc-node/bridge/venv/bin/python -m telegram_bot --path /root
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=70
# Memory guard (#1877): bound the frontend's cgroup below the host so one
# runaway agent child is throttled/killed inside it, and keep the unit alive
# when that child is OOM-killed instead of SIGKILLing every in-flight session.
# For an already installed unit the same values can be applied as a drop-in:
#   BRIDGE_SERVICE_NAME=ccc-matrix-bridge bash /opt/ccc-node/bridge/service-systemd.sh memory-guard
MemoryHigh=50%
MemoryMax=75%
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
